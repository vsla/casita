# ---------- Instalação com Docker ----------
CASITA_PORT=3100
# Use 127.0.0.1 se só um proxy local deve acessar o painel.
CASITA_BIND_IP=0.0.0.0

# ---------- Primeira instalação (banco vazio) ----------
BOOTSTRAP_HOUSE_NAME="Minha casa"
BOOTSTRAP_HOUSE_TIMEZONE=America/Sao_Paulo
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=Administrador
# Obrigatória na primeira execução, mínimo de 12 caracteres. Use aspas simples se houver $ ou #.
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- API (DATABASE_URL abaixo é para desenvolvimento fora do Docker) ----------
PORT=3100
DATABASE_URL=postgres://homehub:homehub@localhost:5432/homehub
# Cookie "Secure" exige HTTPS. Na rede local sem HTTPS use false; na VPS com Caddy, true.
COOKIE_SECURE=false
# Só se o frontend for servido de OUTRO domínio (ex.: https://casa.exemplo.com). Separe por vírgula.
CORS_ORIGINS=
# Fotos enviadas (relativo à raiz do repositório)
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=15

# ---------- Integrações (todas opcionais) ----------
# Câmera RTSP (ver docs/camera-gateway.md). Preencha conforme seu modelo.
CAMERA_RTSP_URL=
# Use http://camera:1984 com Docker ou http://127.0.0.1:1984 com API local.
CAMERA_GATEWAY_URL=
# Deixe em branco para vídeo autenticado pelo próprio Casita.
CAMERA_PUBLIC_URL=
CAMERA_GATEWAY_KIND=go2rtc
CAMERA_STREAM=camera
CAMERA_NAME=Câmera

# Calendário iCloud via CalDAV — e-mail do Apple ID + senha de APP (appleid.apple.com),
# nunca a senha da conta. Os calendários são escolhidos em Ajustes → Integrações.
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
# Opcional: nomes dos calendários, separados por vírgula (alternativa a escolher em Ajustes)
ICLOUD_CALENDARS=

# Spotify (ver docs/spotify.md) — app criado em developer.spotify.com. Controle exige Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Padrão: http://127.0.0.1:3100/api/integrations/spotify/callback (cadastre igual no app do Spotify)
SPOTIFY_REDIRECT_URI=

# Lavanderia (futuro)
MIDEA_MODEL=

# ---------- Frontend (build) ----------
# Vazio = mesma origem (recomendado: a API serve o build, ou o Caddy faz proxy de /api).
VITE_API_URL=
