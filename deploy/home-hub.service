# systemd (Linux do PC da casa) — sem Docker para a aplicação, Postgres nativo ou em container.
#   sudo cp deploy/home-hub.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now home-hub
#   journalctl -u home-hub -f
[Unit]
Description=Casita (Home Hub)
After=network-online.target postgresql.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=casa
WorkingDirectory=/home/casa/home-hub
Environment=NODE_ENV=production
EnvironmentFile=/home/casa/home-hub/.env
# Ajuste o caminho do Node 24 (ex.: /usr/bin/node via NodeSource, ou nvm)
ExecStart=/usr/bin/env pnpm --filter api start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
